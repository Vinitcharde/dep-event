<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1920 1080" width="100%" height="100%">
  <defs>
    <!-- Background Moody Blue Sky Gradient -->
    <linearGradient id="skyGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#02050f" />
      <stop offset="35%" stop-color="#071329" />
      <stop offset="65%" stop-color="#142c52" />
      <stop offset="85%" stop-color="#0e203f" />
      <stop offset="100%" stop-color="#030814" />
    </linearGradient>

    <!-- Mist / Fog Radial Light -->
    <radialGradient id="mistGlow" cx="50%" cy="55%" r="65%">
      <stop offset="0%" stop-color="#2a5286" stop-opacity="0.75" />
      <stop offset="45%" stop-color="#163158" stop-opacity="0.5" />
      <stop offset="80%" stop-color="#09172e" stop-opacity="0.2" />
      <stop offset="100%" stop-color="#020612" stop-opacity="0" />
    </radialGradient>

    <!-- Gold Vertebrae Spine Gradient -->
    <linearGradient id="goldSpine" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#8a611c" />
      <stop offset="25%" stop-color="#e5b84c" />
      <stop offset="50%" stop-color="#fff2a8" />
      <stop offset="75%" stop-color="#d49b28" />
      <stop offset="100%" stop-color="#6e490e" />
    </linearGradient>

    <!-- Dark Corinthian Helmet Metallic Gradient -->
    <linearGradient id="helmetMetal" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1b2230" />
      <stop offset="40%" stop-color="#0c121d" />
      <stop offset="70%" stop-color="#060910" />
      <stop offset="100%" stop-color="#020408" />
    </linearGradient>

    <!-- Gold Trim Gradient -->
    <linearGradient id="goldTrim" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#fae082" />
      <stop offset="50%" stop-color="#c89327" />
      <stop offset="100%" stop-color="#78500c" />
    </linearGradient>

    <!-- Fog filter blur -->
    <filter id="fogBlur" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="30" />
    </filter>
    
    <filter id="softGlow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="8" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>

  <!-- Base Sky & Atmosphere -->
  <rect width="1920" height="1080" fill="url(#skyGrad)" />
  <rect width="1920" height="1080" fill="url(#mistGlow)" />

  <!-- Distant Moody Fog Layers -->
  <ellipse cx="960" cy="580" rx="900" ry="260" fill="#1e3f6f" opacity="0.4" filter="url(#fogBlur)" />
  <ellipse cx="500" cy="560" rx="600" ry="200" fill="#2d588e" opacity="0.35" filter="url(#fogBlur)" />
  <ellipse cx="1400" cy="570" rx="550" ry="220" fill="#224778" opacity="0.3" filter="url(#fogBlur)" />

  <!-- Distant Left Mountain / Cliff in Mist -->
  <path d="M 120 620 Q 280 400 480 370 Q 560 360 620 440 Q 680 520 780 620 Z" fill="#0c1b33" opacity="0.8" />
  <path d="M 180 620 Q 320 420 490 390 Q 550 420 610 500 Q 660 560 740 620 Z" fill="#081426" opacity="0.9" />
  <path d="M 220 620 Q 350 450 470 420 Q 530 460 590 540 Z" fill="#050d1a" />

  <!-- Distant Right Cliffs in Mist -->
  <path d="M 1100 620 Q 1200 510 1280 490 Q 1380 540 1480 620 Z" fill="#0a172c" opacity="0.7" />

  <!-- Misty Horizon Band / Sea Level -->
  <rect x="0" y="570" width="1920" height="90" fill="#18365d" opacity="0.45" filter="url(#fogBlur)" />

  <!-- Silhouetted Army / Troops standing in the Fog -->
  <g fill="#060e1d" opacity="0.7">
    <!-- Left troop silhouettes -->
    <path d="M 400 630 l 12 -45 l 8 45 z M 430 630 l 14 -50 l 6 50 z M 460 630 l 10 -42 l 10 42 z M 490 630 l 15 -55 l 5 55 z M 520 630 l 12 -48 l 8 48 z M 560 630 l 14 -52 l 6 52 z M 600 630 l 10 -40 l 10 40 z M 640 630 l 12 -46 l 8 46 z M 680 630 l 15 -50 l 5 50 z M 720 630 l 11 -44 l 9 44 z M 760 630 l 14 -54 l 6 54 z" />
    <!-- Right troop silhouettes -->
    <path d="M 1150 630 l 12 -45 l 8 45 z M 1180 630 l 14 -50 l 6 50 z M 1220 630 l 10 -42 l 10 42 z M 1260 630 l 15 -55 l 5 55 z M 1300 630 l 12 -48 l 8 48 z M 1340 630 l 14 -52 l 6 52 z M 1380 630 l 10 -40 l 10 40 z M 1420 630 l 12 -46 l 8 46 z M 1460 630 l 15 -50 l 5 50 z M 1500 630 l 11 -44 l 9 44 z M 1540 630 l 14 -54 l 6 54 z M 1580 630 l 12 -46 l 8 46 z" />
  </g>

  <!-- Midground Ground Fog Over Troops -->
  <ellipse cx="960" cy="620" rx="960" ry="60" fill="#132b4f" opacity="0.6" filter="url(#fogBlur)" />
  <ellipse cx="960" cy="670" rx="800" ry="70" fill="#0b1a33" opacity="0.75" filter="url(#fogBlur)" />

  <!-- Dark Foreground Terrain Slope -->
  <path d="M 0 680 Q 500 660 960 690 Q 1420 660 1920 680 L 1920 1080 L 0 1080 Z" fill="#02050b" />

  <!-- ========================================================================= -->
  <!-- HERO WARRIOR (Centered Back View, Corinthian Helmet & Gold Spine Vertebrae) -->
  <!-- ========================================================================= -->
  <g id="warrior-figure" transform="translate(0, 0)">
    
    <!-- Cloak & Broad Shoulders (Dark Texturing) -->
    <path
      d="M 480 1080 C 520 820, 680 690, 810 635 C 870 610, 930 600, 960 600 C 990 600, 1050 610, 1110 635 C 1240 690, 1400 820, 1440 1080 Z"
      fill="#04070e"
    />
    <!-- Cloak folds & drape highlights -->
    <path
      d="M 680 730 C 740 850, 780 960, 810 1080 M 820 660 C 860 800, 890 940, 910 1080 M 1100 660 C 1060 800, 1030 940, 1010 1080 M 1240 730 C 1180 850, 1140 960, 1110 1080"
      stroke="#0a1221"
      stroke-width="12"
      fill="none"
      stroke-linecap="round"
      opacity="0.8"
    />

    <!-- Neck / Collar Armor Guard -->
    <path
      d="M 830 630 C 880 570, 1040 570, 1090 630 C 1050 655, 870 655, 830 630 Z"
      fill="#0c1524"
      stroke="#060b13"
      stroke-width="4"
    />
    <path
      d="M 850 625 C 890 585, 1030 585, 1070 625 Z"
      fill="#142034"
      opacity="0.6"
    />

    <!-- Black Bronze Helmet Dome (Corinthian Form Back View) -->
    <path
      d="M 800 520 C 785 360, 830 230, 960 210 C 1090 230, 1135 360, 1120 520 C 1100 590, 820 590, 800 520 Z"
      fill="url(#helmetMetal)"
      stroke="#04060b"
      stroke-width="5"
    />

    <!-- Helmet Metallic Sheen & Specular Lighting (Left and Right Rim Highlights) -->
    <path
      d="M 808 490 C 800 380, 840 260, 920 220"
      stroke="#2c4263"
      stroke-width="8"
      fill="none"
      opacity="0.5"
      filter="url(#softGlow)"
    />
    <path
      d="M 1112 490 C 1120 380, 1080 260, 1000 220"
      stroke="#19283d"
      stroke-width="7"
      fill="none"
      opacity="0.4"
    />

    <!-- Helmet Lower Flange & Neck Flared Rim -->
    <path
      d="M 790 530 C 830 575, 1090 575, 1130 530 C 1110 595, 810 595, 790 530 Z"
      fill="#080d16"
      stroke="#030509"
      stroke-width="3"
    />

    <!-- Crest Base Support Ring (Gold Trim Arch) -->
    <path
      d="M 880 290 C 880 210, 1040 210, 1040 290 C 1020 310, 900 310, 880 290 Z"
      fill="url(#goldTrim)"
      stroke="#472d07"
      stroke-width="3"
    />

    <!-- Crest Plume / Horsehair Crest (Dark Black-Blue Plume Arching High) -->
    <path
      d="M 850 320 C 820 180, 870 70, 960 60 C 1050 70, 1100 180, 1070 320 C 1030 230, 890 230, 850 320 Z"
      fill="#060a12"
      stroke="#020408"
      stroke-width="4"
    />
    <!-- Plume Texture Strands -->
    <path
      d="M 880 250 C 860 170, 900 100, 960 90 C 1020 100, 1060 170, 1040 250 M 910 220 C 900 150, 930 110, 960 105 C 990 110, 1020 150, 1010 220"
      stroke="#142236"
      stroke-width="3"
      fill="none"
      opacity="0.75"
    />

    <!-- Gold Crest Filigree Band -->
    <path
      d="M 890 230 Q 960 190 1030 230 Q 960 250 890 230 Z"
      fill="url(#goldSpine)"
      stroke="#573a08"
      stroke-width="2"
      filter="url(#softGlow)"
    />

    <!-- ========================================================================= -->
    <!-- ICONIC GOLDEN SPINE / VERTEBRAE DETAIL RUNNING DOWN HELMET BACK & NAPE    -->
    <!-- ========================================================================= -->
    <g id="gold-vertebrae-spine" filter="url(#softGlow)">
      
      <!-- Vertebra Segment 1 (Top / Atlas Bone) -->
      <path
        d="M 960 325 C 940 315, 925 330, 940 345 C 955 348, 965 348, 980 345 C 995 330, 980 315, 960 325 Z"
        fill="url(#goldSpine)"
        stroke="#4a3006"
        stroke-width="2"
      />
      <!-- Vertebra 1 Lateral Wing Horns -->
      <path
        d="M 932 332 C 905 322, 915 352, 942 344 M 988 332 C 1015 322, 1005 352, 978 344"
        fill="url(#goldSpine)"
        stroke="#4a3006"
        stroke-width="2"
      />

      <!-- Vertebra Segment 2 -->
      <path
        d="M 960 355 C 938 345, 920 362, 938 378 C 954 382, 966 382, 982 378 C 1000 362, 982 345, 960 355 Z"
        fill="url(#goldSpine)"
        stroke="#4a3006"
        stroke-width="2"
      />
      <!-- Vertebra 2 Lateral Wing Horns -->
      <path
        d="M 928 360 C 895 350, 908 385, 940 375 M 992 360 C 1025 350, 1012 385, 980 375"
        fill="url(#goldSpine)"
        stroke="#4a3006"
        stroke-width="2"
      />

      <!-- Vertebra Segment 3 (Mid Helmet Ridge) -->
      <path
        d="M 960 388 C 936 376, 918 395, 936 412 C 953 416, 967 416, 984 412 C 1002 395, 984 376, 960 388 Z"
        fill="url(#goldSpine)"
        stroke="#4a3006"
        stroke-width="2"
      />
      <!-- Vertebra 3 Lateral Wing Horns -->
      <path
        d="M 924 394 C 885 382, 900 422, 938 410 M 996 394 C 1035 382, 1020 422, 982 410"
        fill="url(#goldSpine)"
        stroke="#4a3006"
        stroke-width="2"
      />

      <!-- Vertebra Segment 4 (Central Spine Bulge) -->
      <path
        d="M 960 422 C 934 408, 915 430, 935 448 C 952 452, 968 452, 985 448 C 1005 430, 986 408, 960 422 Z"
        fill="url(#goldSpine)"
        stroke="#4a3006"
        stroke-width="2"
      />
      <!-- Vertebra 4 Lateral Wing Horns -->
      <path
        d="M 920 428 C 878 415, 892 460, 936 446 M 1000 428 C 1042 415, 1028 460, 984 446"
        fill="url(#goldSpine)"
        stroke="#4a3006"
        stroke-width="2"
      />

      <!-- Vertebra Segment 5 (Lower Helmet) -->
      <path
        d="M 960 458 C 932 444, 912 468, 934 486 C 952 490, 968 490, 986 486 C 1008 468, 988 444, 960 458 Z"
        fill="url(#goldSpine)"
        stroke="#4a3006"
        stroke-width="2"
      />
      <!-- Vertebra 5 Lateral Wing Horns -->
      <path
        d="M 918 464 C 872 450, 888 498, 935 484 M 1002 464 C 1048 450, 1032 498, 985 484"
        fill="url(#goldSpine)"
        stroke="#4a3006"
        stroke-width="2"
      />

      <!-- Vertebra Segment 6 (Nape of Neck Transition) -->
      <path
        d="M 960 496 C 934 482, 915 504, 935 522 C 952 526, 968 526, 985 522 C 1005 504, 986 482, 960 496 Z"
        fill="url(#goldSpine)"
        stroke="#4a3006"
        stroke-width="2"
      />
      <!-- Vertebra 6 Lateral Wing Horns -->
      <path
        d="M 922 502 C 880 490, 894 532, 936 520 M 998 502 C 1040 490, 1026 532, 984 520"
        fill="url(#goldSpine)"
        stroke="#4a3006"
        stroke-width="2"
      />

      <!-- Vertebra Segment 7 (Cervical Vertebra at Armor Joint) -->
      <path
        d="M 960 532 C 936 520, 920 538, 938 554 C 954 558, 966 558, 982 554 C 1000 538, 984 520, 960 532 Z"
        fill="url(#goldSpine)"
        stroke="#4a3006"
        stroke-width="2"
      />
      <!-- Vertebra 7 Wings -->
      <path
        d="M 926 536 C 890 528, 902 562, 938 552 M 994 536 C 1030 528, 1018 562, 982 552"
        fill="url(#goldSpine)"
        stroke="#4a3006"
        stroke-width="2"
      />

      <!-- Vertebra Segment 8 (Tail / Ponytail Bone Link) -->
      <path
        d="M 960 564 C 940 554, 926 568, 940 582 C 954 585, 966 585, 980 582 C 994 568, 980 554, 960 564 Z"
        fill="url(#goldSpine)"
        stroke="#4a3006"
        stroke-width="2"
      />
      <!-- Central Spine Center Ridge Line & Specular Light -->
      <path
        d="M 960 320 L 960 595"
        stroke="#fff5be"
        stroke-width="3"
        stroke-linecap="round"
        opacity="0.85"
      />
    </g>

    <!-- Ponytail / Hair Tufts Extending Down Collar -->
    <path
      d="M 945 590 C 935 640, 940 680, 960 710 C 980 680, 985 640, 975 590 Z"
      fill="#03060c"
      stroke="#020306"
      stroke-width="2"
    />
  </g>

  <!-- Cinema Anamorphic Letterbox Vignette Outer Bounds -->
  <rect width="1920" height="1080" fill="none" stroke="#000000" stroke-width="1" />
</svg>
